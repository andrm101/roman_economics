<https://github.com/andrm101/roman_economics/id/claim/ANC-ARABARCH-IVORY> a rx:Anchor ;
    dcterms:identifier "ANC-ARABARCH-IVORY" ;
    rx:aboutDocument <https://github.com/andrm101/roman_economics/id/doc/DOC-PVINDOB-G40822> ;
    rx:claimText "NOT a statutory rate: ratio of the surplus taken beyond the exact quarter (11 3/4 minae) to the listed three-quarter ivory (78 T 54 3/4 min) = 0.248%. Ratio first stated by Nappo 2018: 89." ;
    rx:epistemicStatus rxv:epistemic-accepted_working ;
    rx:locus "P.Vindob. G 40822 verso col. ii ll. 11-12" ;
    rx:page "v col. ii ll. 4; 11-14" ;
    rx:quantityConcept "levy_rate_arabarchs_ivory" ;
    rx:recordOrigin rxv:origin-scholarly_reconstruction ;
    rx:reportedIn <https://github.com/andrm101/roman_economics/id/source/SRC-DDBDP-TM27666> ;
    rx:reviewStatus rxv:review-inspected ;
    rx:unit <https://github.com/andrm101/roman_economics/id/unit/fraction> ;
    rx:valueHigh 2.5e-03 ;
    rx:valueLow 2.5e-03 .

