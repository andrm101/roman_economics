# CQ9 For parameter ?param: contested questions among its inputs, all positions, selection and deciding decision.
PREFIX rx: <https://github.com/andrm101/roman_economics/ontology#>
PREFIX rxv: <https://github.com/andrm101/roman_economics/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?question ?status ?position ?selected ?decision ?positionStatus WHERE {
  { ?param rx:derivedFrom ?x . } UNION { ?param rx:considered ?x . }
  ?question rx:hasPosition ?x ; rx:hasPosition ?position ; rx:questionStatus ?status .
  ?position rx:epistemicStatus ?positionStatus .
  OPTIONAL { ?question rx:selectedPosition ?selected . }
  OPTIONAL { ?question rx:selectedBy ?decision . }
}
