# CQ6 Which conversion rules (and code) produced this value? Bind ?target (parameter or claim node).
PREFIX rx: <https://github.com/andrm101/roman_economics/ontology#>
PREFIX rxv: <https://github.com/andrm101/roman_economics/vocab/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?target ?activity ?code ?rule ?scope ?ruleStatus ?usedClaim WHERE {
  ?activity prov:generated ?target ; rx:code ?code .
  OPTIONAL { ?activity rx:usedRule ?rule . ?rule rx:scope ?scope ; rx:ruleStatus ?ruleStatus . }
  OPTIONAL { ?activity prov:used ?usedClaim . ?usedClaim rx:recordOrigin ?o . }   # claims carry a record origin
}
